  "directions": {
    "c-to-cpp": {
      "source": "c",
      "target": "cpp",
      "path": "skills/directions/c-to-cpp/SKILL.md",
      "references": [
        {
          "id": "c-to-cpp-header-macro",
          "path": "skills/directions/c-to-cpp/references/header-macro.md",
          "triggerSummary": "C 源依赖隐式可见平台宏/函数（min/max/bzero/strlcpy）、存在整头跨平台缺失，或目标含 <windows.h> 宏冲突时加载",
          "triggerSignals": [
            "<sys/param.h>",
            "<windows.h>",
            "<libutil.h>",
            "<fts.h>",
            "<sys/queue.h>",
            "<sysexits.h>",
            "bzero",
            "strlcpy",
            "NOMINMAX",
            "min(",
            "max("
          ]
        },
        {
          "id": "c-to-cpp-type-abi",
          "path": "skills/directions/c-to-cpp/references/type-abi.md",
          "triggerSummary": "转换涉及共享头文件、extern \"C\" 导出接口、二进制结构布局（sizeof/offsetof）、void* 强转、typedef 符号冲突或指定初始化时加载",
          "triggerSignals": [
            "extern \"C\"",
            "offsetof(",
            "sizeof(",
            "void*",
            "typedef ",
            "malloc("
          ]
        }
      ]
    },
